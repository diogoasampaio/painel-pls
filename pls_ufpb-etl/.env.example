MONGO_URI=mongodb://etl_user:CHANGE_ME@127.0.0.1:27017/?authSource=painel_pls
MONGO_DB=painel_pls

# Chave da API do Portal da Transparencia (cadastro gratuito via gov.br).
# Opcional: so cobre os dias recentes cujo arquivo diario ainda nao saiu.
# https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
PORTAL_API_KEY=
# Requisicoes por minuto (limite oficial ~90 de dia; mais alto de 00h-06h)
PORTAL_RPM=80
# Dias recentes rebaixados a cada carga (o Portal publica com atraso)
PORTAL_CACHE_DIAS=45
# Arquivos diarios de despesas (dados abertos): a CGU bloqueia o IP (405)
# apos ~25 downloads seguidos -- ritmo baixo e pausa longa ao ser bloqueado
PORTAL_BULK_RPM=4
PORTAL_BULK_PAUSA_S=900
PORTAL_BULK_TENTATIVAS=2

# Instituicao
CODIGO_ORGAO_SIAFI=26240
UGS=153065,153066,153073,153074
CO_IES_INEP=579

# Onde ficam data/raw e data/processed (padrao: ./data)
# DATA_DIR=/var/lib/pls-etl

# Alerta da saude da carga (run.py mensal / saude). Sem SMTP_HOST ou
# ALERTA_EMAILS, a saude so imprime e grava pls_saude_carga.
SMTP_HOST=
SMTP_PORTA=587
SMTP_TLS=1
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=painel-pls@ufpb.br
# destinatarios separados por virgula
ALERTA_EMAILS=
# endereco publico do painel, para o link no e-mail
PAINEL_URL=https://exemplo.ufpb.br/painel-pls
