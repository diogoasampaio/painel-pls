# So lido no servidor (server components / route handlers). Nunca prefixar
# com NEXT_PUBLIC_ -- a URL da API interna nao deve chegar ao navegador.
API_BASE_URL=http://127.0.0.1:8001

# Tema de cores deste projeto: ufpb (cores do brasao), neutro, blue, green ou violet
# (lib/tema.ts). Paginas estaticas leem no build: defina antes do `next build`.
TEMA_DS=ufpb

# Faixa "Versão em validação" no topo das páginas (sim | nao). Desligar quando a Comissão validar o painel.
PAINEL_EM_VALIDACAO=sim
